{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./out",
        "rootDir": "./src",

        /* Linting */
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "strict": true
    },
    "include": ["src"]
}
