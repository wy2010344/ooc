{
    "name": "ooc-mve-bridge",
    "description": "MVE view bridge for OOC: dom elements, text, html, fc components, and forEach",
    "version": "0.0.1",
    "type": "module",
    "files": [
        "out"
    ],
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "development": "./src/index.ts",
            "default": "./out/index.js"
        },
        "./dom": {
            "types": "./out/dom.d.ts",
            "development": "./src/dom.ts",
            "default": "./out/dom.js"
        },
        "./fc": {
            "types": "./out/fc.d.ts",
            "development": "./src/fc.ts",
            "default": "./out/fc.js"
        },
        "./types": {
            "types": "./out/types.d.ts",
            "development": "./src/types.ts",
            "default": "./out/types.js"
        }
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "tsc"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "mve-core": "*",
        "mve-dom": "*",
        "mve-dom-helper": "file:../../../es-pseudo-monorepo/packages/mve/dom-helper",
        "mve-helper": "*",
        "mve-three": "*",
        "three": "^0.184.0",
        "mve-icons": "^6.0.0",
        "object-oriented-c-language": "0.0.1",
        "wy-dom-helper": "*",
        "wy-helper": "*"
    },
    "devDependencies": {
        "@types/three": "^0.184.0",
        "shx": "~0.4.0",
        "typescript": "~6.0.2"
    }
}
