        "idb": "^8.0.3",
        "langium": "~4.2.1",
        "mve-core": "*",
        "mve-dom": "*",
        "mve-helper": "*",
        "object-oriented-c-language": "0.0.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "wouter": "^3.6.0",
        "wy-dom-helper": "*",
        "wy-helper": "*"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.0",
