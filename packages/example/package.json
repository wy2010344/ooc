{
    "name": "object-oriented-c-example",
    "description": "OOC 项目示例：源码 src/ooc/ + 顶层 config.ooc，依赖经 ooc install 装进 .ooc_modules/",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "ooc:install": "node ../cli/bin/cli.js install ../base/src",
        "ooc:build": "node ../cli/bin/cli.js build src/ooc/app.ooc -o src/ooc-gen",
        "predev": "npm run ooc:install && npm run ooc:build",
        "prebuild": "npm run ooc:install && npm run ooc:build",
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "object-oriented-c-language": "0.0.1",
        "mve-core": "*",
        "mve-dom": "*",
        "ooc-mve-bridge": "*",
        "wy-dom-helper": "*",
        "wy-helper": "*"
    },
    "devDependencies": {
        "typescript": "~6.0.2",
        "vite": "^8.2.0"
    }
}
