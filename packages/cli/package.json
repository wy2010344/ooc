{
    "name": "object-oriented-c-cli",
    "description": "The cli specific package",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "bin",
        "out",
        "src"
    ],
    "main": "./out/main.js",
    "module": "./out/main.js",
    "exports": {
        ".": {
            "types": "./out/main.d.ts",
            "development": "./src/main.ts",
            "default": "./out/main.js"
        }
    },
    "bin": {
        "ooc": "./bin/cli.js"
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "echo 'No build step'",
        "build:clean": "npm run clean && npm run build",
        "test": "tsc -b tsconfig.test.json && node --import ./test/preload-batch.mjs --test \"out/**/*.test.js\""
    },
    "dependencies": {
        "object-oriented-c-language": "0.0.1",
        "chalk": "~5.6.2",
        "commander": "~14.0.3"
    },
    "volta": {
        "node": "24.15.0",
        "npm": "11.12.1"
    }
}