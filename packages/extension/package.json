{
    "name": "vscode-ooc",
    "description": "The extension specific package",
    "version": "0.0.1",
    "displayName": "ooc",
    "type": "module",
    "engines": {
        "vscode": "^1.67.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "object-oriented-c",
                "aliases": [
                    "Object-Oriented C",
                    "object-oriented-c"
                ],
                "extensions": [
                    ".ooc"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "object-oriented-c",
                "scopeName": "source.object-oriented-c",
                "path": "syntaxes/object-oriented-c.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:object-oriented-c"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/object-oriented-c.tmLanguage.json ./syntaxes/object-oriented-c.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "object-oriented-c-language": "0.0.1",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "~1.110.0",
        "concurrently": "~9.2.1",
        "esbuild": "~0.27.4"
    },
    "vsce": {
        "dependencies": false
    }
}